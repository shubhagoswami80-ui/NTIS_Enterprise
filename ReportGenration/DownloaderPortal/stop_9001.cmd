@echo off
set "PORT=9001"
powershell.exe -NoProfile -Command "$c=Get-NetTCPConnection -LocalPort %PORT% -State Listen -ErrorAction SilentlyContinue; if(-not $c){Write-Host 'Downloader Portal is not listening on port %PORT%.'; exit 0}; $p=Get-CimInstance Win32_Process -Filter ('ProcessId=' + $c.OwningProcess); Write-Host ('Port %PORT% listener PID: ' + $c.OwningProcess); Write-Host ('Command: ' + $p.CommandLine); if(($p.CommandLine -notmatch 'DownloaderPortal') -or ($p.CommandLine -notmatch 'streamlit')){Write-Host 'REFUSED: PID is not verified as Downloader Portal. No process was terminated.'; exit 5}; Write-Host 'Stopping verified Downloader Portal process tree...'; taskkill.exe /PID $c.OwningProcess /T /F | Out-Null; Start-Sleep -Seconds 2; $left=Get-NetTCPConnection -LocalPort %PORT% -State Listen -ErrorAction SilentlyContinue; if($left){Write-Host ('ERROR: Port %PORT% is still occupied by PID ' + $left.OwningProcess); exit 6}; Write-Host 'Downloader Portal stopped. Port %PORT% is free.'"
exit /b %errorlevel%
