<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirect to Cashfree Checkout</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        .cf-loader {
            height: 100vh;
            height: 100dvh;
            background-color: white;
        }

        .loader-container {
            width: 410px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate3d(-50%, -50%, 0);
        }

        .generic-loader-icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #redirect-container {
            width: 200px;
            text-align: center;
            position: absolute;
            top: 220px;
            left: 50%;
            transform: translate(-50%, -50%);
            display: none;
        }

        .redirect-helper {
            font-size: 14px;
            font-weight: 500;
        }

        .redirect-btn {
            display: block;
            font-weight: 600;
            font-size: 14px;
            color: #6930ca;
            text-decoration: none !important;
            margin-top: 8px;
        }

        .loader-bg-gray {
            background-color: rgba(0, 0, 0, 0.6) !important;
        }
    </style>
</head>

<body>
    <div class="cf-loader">
        <div class="loader-container">
        
            <img
                src="data:image/svg+xml;base64,"
            />

        
            <div id="redirect-container">
                <p class="redirect-helper">Taking too long?</p>
                <a
                    href=""
                    target="_self"
                    class="redirect-btn"
                    id="cf-redirect-btn"
                >
                    Go to the next step ➔
                </a>
            </div>
        </div>
    </div>
    <div id="invisible-cf-div" style="width: 1px; height: 1px; display: none;">
        <input id="cf-psid" type="text" name="payment_session_id" value='session_wYUUYKLNGShRbvm8BIqxL0vuA4A-hPHqWZO_9Mhsyoa3xPEyRsA0yLRf0EfPJgU6rG3foUb73sZh3n5mKpRgO-1R2pi8_n4DOWBhnmYflpYD704VcSgH1sljjwpaymentpayment' />
        <input id="cf-psid-n" type="text" name="payment_nonce" value='Lw21G9MXrioQD48LX6D1tc0G-XiWSsiurtDWCttES8k' />
        <input id="cf-link-n" type="text" name="link" value='https://api.cashfree.com/checkout' />
        <input id="cf-chx-route" type="text" name="checkout_route" value='/' />
        <input id="cf-redirect-to-address" type="text" name="redirect_to_address" value='false' />
        <input id="cf-redirect-to-payment" type="text" name="redirect_to_payment" value='false' />
        <input id="cf-cookie-disable" type="text" name="disable_cookies" value='false' />
        <input id="cf_chx_form_submit_track" type="text" name="checkout_track" value='60' />
        <input id="cf-auto-login-occ-enabled" type="text" name="auto_login_occ_enabled" value='false' />
        <input id="cf-result-auth-phone-cookie" type="text" name="result_auth_phone_cookie" value='false' />
           
    </div>
   
    <script src="https://api.cashfree.com/pg/static/js/checkout_auth_relay.js"></script>
</body>

</html>