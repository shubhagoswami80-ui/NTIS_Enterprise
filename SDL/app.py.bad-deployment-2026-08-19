EARLY_THRESHOLD = 22.0
STRONG_THRESHOLD = 65.0

def _events():
    v = load_events(EVENT_CSV)
    return pd.DataFrame() if v is None else v.copy()

def _state():
    try: return load_state(STATE_JSON) or {}
    except Exception: return {}

def _date(v):
    x=pd.to_datetime(v,errors="coerce")
    return "" if pd.isna(x) else x.strftime("%Y-%m-%d")

def _safe(df,c):
    return pd.to_numeric(df[c],errors="coerce") if c in df.columns else pd.Series(np.nan,index=df.index,dtype=float)

def _files(d):
    try: return sorted([Path(p) for p in discover_historical_snapshots(d) if Path(p).is_file()], key=lambda p:p.stat().st_mtime)
    except Exception: return []

def _latest(d):
    f=_files(d); return max(f,key=lambda p:p.stat().st_mtime) if f else None

def _valid_base_file(path):
    try:
        x=pd.read_excel(path)
    except Exception: return False
    if "Symbol" not in x.columns or "Open" not in x.columns or "ATM Straddle %" not in x.columns: return False
    s=pd.to_numeric(x["Open"],errors="coerce"); a=pd.to_numeric(x["ATM Straddle %"],errors="coerce")
    return int((s.gt(0)&a.notna()).sum()) > 0

def _first_valid(d):
    for p in _files(d):
        if _valid_base_file(p): return p
    return None

def _read_all_sheets(path):
    if path is None: return pd.DataFrame()
    try: sheets=pd.read_excel(path,sheet_name=None)
    except Exception: return pd.DataFrame()
    frames=[]
    for name,raw in sheets.items():
        if raw is None or raw.empty or "Symbol" not in raw.columns: continue
        x=raw.copy()
        x["Symbol"]=x["Symbol"].astype(str).str.strip().str.upper()
        x["_sheet"]=name
        frames.append(x)
    if not frames: return pd.DataFrame()
    # Prefer the richest sheet per symbol; then overlay missing values from other sheets.
    out=pd.concat(frames,ignore_index=True,sort=False)
    out=out.drop_duplicates(["Symbol"],keep="last")
    return out

def _orb_status(row):
    # Use explicit ORB fields only. Never fabricate a 15-minute range from daily High/Low.
    cols={str(c).strip().lower():c for c in row.index}
    hi=next((cols[k] for k in ("orb high","15 min orb high","15min orb high","opening range high") if k in cols),None)
    lo=next((cols[k] for k in ("orb low","15 min orb low","15min orb low","opening range low") if k in cols),None)
    px=next((cols[k] for k in ("current price","cmp","close") if k in cols),None)
    if hi and lo and px:
        h=pd.to_numeric(row.get(hi),errors="coerce"); l=pd.to_numeric(row.get(lo),errors="coerce"); p=pd.to_numeric(row.get(px),errors="coerce")
        if pd.notna(h) and pd.notna(l) and pd.notna(p):
            if p>h:return "ORB ↑"
            if p<l:return "ORB ↓"
            return "ORB —"
    return "ORB N/A"

def _rank_abs(s):
    s=pd.to_numeric(s,errors="coerce")
    if s.notna().sum()<=1:return pd.Series(np.where(s.notna(),.5,np.nan),index=s.index)
    return s.abs().rank(method="average",pct=True).clip(0,1)

def _prediction(base, source):
    if base.empty:return pd.DataFrame()
    x=base.copy()
    x["symbol"]=x["symbol"].astype(str).str.strip().str.upper()
    x["progress"]=_safe(x,"approach_progress_pct")
    x=x[x["progress"].gt(EARLY_THRESHOLD)].copy()
    if x.empty:return pd.DataFrame()
    if "observation_timestamp" in x:
        x["_ts"]=pd.to_datetime(x["observation_timestamp"],errors="coerce")
        x=x.sort_values(["symbol","_ts"]).drop_duplicates("symbol",keep="last")
    if source.empty:return x.assign(price_chg=np.nan,oi_chg=np.nan,iv_chg=np.nan,pcr_chg=np.nan,ce_oi=np.nan,pe_oi=np.nan,fut_oi=np.nan,orb="ORB N/A")
    wanted=["Price Chg %","OI Chg %","IV Chg %","PCR Chg %","Tot CE OI Chg %","Tot PE OI Chg %","Tot PE-CE OI Chg"]
    src=source.copy()
    for c in wanted:
        if c not in src: src[c]=np.nan
        src[c]=pd.to_numeric(src[c],errors="coerce")
    # Futures OI aliases are intentionally detected, not hard-coded to one vendor spelling.
    fmap={}
    for c in src.columns:
        k=str(c).strip().lower().replace("_"," ")
        if "future" in k and "oi" in k and ("chg" in k or "change" in k):
            fmap[c]="fut_oi"
    for c in fmap:
        src["fut_oi"]=src[c]; break
    if "fut_oi" not in src: src["fut_oi"]=np.nan
    src=src.drop_duplicates("Symbol",keep="last")
    x=x.merge(src[["Symbol"]+wanted+["fut_oi"]],left_on="symbol",right_on="Symbol",how="left").drop(columns=["Symbol"],errors="ignore")
    direction=x.get("direction",pd.Series("",index=x.index)).astype(str).str.upper()
    price=_safe(x,"Price Chg %")
    aligned=((direction=="UP")&(price>0))|((direction=="DOWN")&(price<0))
    # Early prediction score: evidence strength, not a calibrated probability.
    score=pd.Series(0.0,index=x.index)
    score += np.where(aligned,25,0)
    score += np.where(price.isna(),0,_rank_abs(price)*10)
    score += _rank_abs(_safe(x,"IV Chg %")).fillna(0)*12
    score += _rank_abs(_safe(x,"OI Chg %")).fillna(0)*12
    score += _rank_abs(_safe(x,"PCR Chg %")).fillna(0)*8
    score += _rank_abs(_safe(x,"Tot PE-CE OI Chg")).fillna(0)*10
    score += np.where(_safe(x,"fut_oi").notna(),_rank_abs(_safe(x,"fut_oi")).fillna(0)*13,0)
    score += ((x["progress"]-EARLY_THRESHOLD).clip(0,28)/28)*20
    x["orb"]=[_orb_status(r) for _,r in x.iterrows()]
    orb_bonus=[]
    for d,o in zip(direction,x["orb"]):
        orb_bonus.append(8 if ((d=="UP" and o=="ORB ↑") or (d=="DOWN" and o=="ORB ↓")) else 0)
    score += pd.Series(orb_bonus,index=x.index)
    x["strength"]=score.clip(0,100).round(1)
    x["decision"]=np.where(x["strength"].ge(STRONG_THRESHOLD),"EARLY ENTRY CANDIDATE","DEVELOPING")
    # Only actionable candidates are shown. Developing is suppressed from the main decision view.
    x=x[x["strength"].ge(STRONG_THRESHOLD)].copy()
    return x.sort_values(["strength","progress"],ascending=False)

