# SDL runtime configuration.
# All values are optional. Relative paths are resolved from SDL_PROJECT_ROOT.

# SDL_PROJECT_ROOT=C:\Your\SDL\Project
# SDL_INPUT_DIR=C:\Your\SDL\Inputs
# SDL_EVENT_DIR=C:\Your\SDL\Runtime\Events
# SDL_STATE_DIR=C:\Your\SDL\Runtime\State
# SDL_LOG_DIR=C:\Your\SDL\Runtime\Logs

# Optional explicit event/state locations:
# SDL_EVENT_CSV=C:\Your\SDL\Runtime\Events\breakout_events.csv
# SDL_STATE_JSON=C:\Your\SDL\Runtime\State\processing_state.json

# Dashboard:
# SDL_DASHBOARD_PORT=8504

# Strategy threshold:
# SDL_BREAKOUT_MULTIPLIER=1.20
